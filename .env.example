# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-value-of-at-least-32-characters

# First admin account (only used while the users table is empty).
# Password: 12+ characters with three of lowercase / uppercase / digit / symbol.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Default model (seeded only while no providers exist; manage later under Models).
LLM_BASE_URL=http://ollama:11434/v1
LLM_DEFAULT_MODEL=qwen2.5:7b-instruct

# Hosts the http_get tool may call (comma separated). Empty = tool disabled.
HTTP_TOOL_ALLOWED_HOSTS=

WEB_PORT=8080
